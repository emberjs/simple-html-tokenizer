{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["qunit"],
    "newLine": "LF",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "simple-html-tokenizer": ["./src/index.ts"]
    }
  },
  "files": ["src/index.ts", "tests/tokenizer-tests.ts"]
}
